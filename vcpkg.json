{
  "$schema": "https://raw.githubusercontent.com/microsoft/vcpkg/master/scripts/vcpkg.schema.json",
  "name": "roblox",
  "version": "1.0.0",
  "dependencies": [
    "boost-filesystem",
    "boost-system",
    "boost-thread",
    "boost-exception",
    "boost-program-options",
    "boost-circular-buffer",
    "boost-pool",
    "boost-math",
    "boost-crc",
    "boost-flyweight",
    "boost-ublas",
    "boost-bimap",
    "boost-accumulators",
    "boost-format",
    "boost-foreach",
    "boost-random",
    {
      "name": "boost-iostreams",
      "features": ["zlib"]
    },
    "curl",
    "zlib",
    "sdl2",
    "openssl",
    "freetype",
    "libpng",
    "libjpeg-turbo"
  ]
}